<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


<!--     How many times we mention bean that many times the object will be created-->
<!--    Scopes in Spring core - singleton and prototype -->

<!--    <bean id = "alien1" class="com.divyansh.Alien" scope="prototype">-->
<!--    </bean>-->



<!--    <bean id = "alien2" class="com.divyansh.Alien">-->
<!--    </bean>-->

<!--     Mentioning id is optional , and Primary Bean -->
    <bean  id = "com1" class="com.divyansh.Laptop"  primary="true">
    </bean>

    <bean  id = "com2" class="com.divyansh.Desktop" lazy-init="true">
    </bean>

    <!--    Setter Injection and  Ref Attribute-->
    <bean id = "alien1" class="com.divyansh.Alien"  autowire="byType">

        <!--    Setter Injection -->
                <property name="age" value="21" />

<!--           Setter Injection with the help of ref Attribute-->
                <property name="com" ref="com2" />

        <!-- Constructor Injection  -->
        <!--  By specifying the type       -->
<!--        <constructor-arg type = "com.divyansh.Laptop" ref="lap1"/>-->
<!--        <constructor-arg type= "int" value="21"/>-->

        <!--        By specifying name  : also use @ConstructorProperties({"age","lap"}) above the constructor  To take care of order-->
<!--        <constructor-arg name = "lap" ref="lap1"/>-->
<!--        <constructor-arg name  = "age" value="21"/>-->

        <!-- By mentioning the index value  -->
<!--        <constructor-arg index="1" ref="lap1"/>-->
<!--        <constructor-arg index = "0" value="21"/>-->

    </bean>

</beans>

<!-- Got the beans definition from spring docs for xml based config and declared a bean with id and class path -->

